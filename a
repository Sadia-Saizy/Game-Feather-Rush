        "from IPython.display import HTML, display\n",
        "\n",
        "game_code = \"\"\"\n",
        "<!DOCTYPE html>\n",
        "<html lang=\"en\">\n",
        "<head>\n",
        "    <meta charset=\"UTF-8\">\n",
        "    <title>Feather Rush - Sound Edition</title>\n",
        "    <style>\n",
        "        body {\n",
        "            background-color: #1a1a2e;\n",
