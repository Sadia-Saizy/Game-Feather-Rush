              "        <strong>Power-Up:</strong> <span id=\"activePowerUp\">None</span>\n",
              "    </div>\n",
              "    <div class=\"controls\">\n",
              "        Controls: Click the <strong>HIGH JUMP</strong> button, or press <strong>SPACEBAR</strong> / <strong>UP ARROW</strong> | Press <strong>R</strong> to Restart\n",
              "    </div>\n",
              "\n",
              "<script>\n",
              "const canvas = document.getElementById('gameCanvas');\n",
              "const ctx = canvas.getContext('2d');\n",
              "const startScreen = document.getElementById('startScreen');\n",
              "\n",
              "let score = 0;\n",
              "let highScore = localStorage.getItem('featherRushHighScore') || 0;\n",
              "document.getElementById('highScoreCount').innerText = highScore;\n",
              "\n",
              "let gameSpeed = 8;\n",
              "let isGameOver = false;\n",
              "let gameStarted = false;\n",
              "let activePowerUpText = \"None\";\n",
              "let powerUpTimer = 0;\n",
              "\n",
              "// Web Audio API Sound Synthesizer\n",
              "let audioCtx = null;\n",
              "function initAudio() {\n",
