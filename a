              "        e.preventDefault();\n",
              "        triggerJump();\n",
              "    }\n",
              "    if (e.code === 'KeyR' && isGameOver) {\n",
              "        resetGame();\n",
              "    }\n",
              "});\n",
              "\n",
              "let frameCount = 0;\n",
              "\n",
              "function spawnObstacle() {\n",
