        "            padding: 10px 24px;\n",
        "            box-shadow: 0 4px 15px rgba(76, 175, 80, 0.4);\n",
        "        }\n",
        "        #jumpBtn:hover {\n",
        "            background-color: #388E3C;\n",
        "        }\n",
        "        .ui-panel {\n",
        "            margin-top: 8px;\n",
