              "}\n",
              "\n",
              "function spawnPowerup() {\n",
              "    const types = ['Super Seed', 'ThreeWings', 'Money Tape', 'Santa Bird', 'Guard Bird', 'Rich Box'];\n",
              "    const chosenType = types[Math.floor(Math.random() * types.length)];\n",
              "    powerups.push({ x: canvas.width, y: Math.random() * 140 + 100, width: 30, height: 30, type: chosenType });\n",
              "}\n",
              "\n",
              "function startGame() {\n",
              "    startScreen.style.display = 'none';\n",
              "    gameStarted = true;\n",
              "    resetGame();\n",
              "    loop();\n",
              "}\n",
              "\n",
              "function resetGame() {\n",
              "    score = 0;\n",
              "    gameSpeed = 8;\n",
              "    isGameOver = false;\n",
              "    obstacles = [];\n",
              "    acorns = [];\n",
              "    powerups = [];\n",
              "    quack.y = 260;\n",
              "    quack.sizeMultiplier = 1;\n",
              "    quack.hasThreeWings = false;\n",
              "    quack.hasGuard = false;\n",
              "    quack.speedBoost = 1;\n",
              "    activePowerUpText = \"None\";\n",
              "}\n",
              "\n",
              "function update() {\n",
              "    if (!gameStarted || isGameOver) return;\n",
              "\n",
              "    frameCount++;\n",
              "\n",
              "    if (frameCount % 85 === 0) spawnObstacle();\n",
              "    if (frameCount % 55 === 0) spawnAcorn();\n",
              "    if (frameCount % 320 === 0) spawnPowerup();\n",
              "\n",
              "    quack.dy += quack.gravity;\n",
              "    quack.y += quack.dy;\n",
              "\n",
              "    let floorY = 325 - (48 * quack.sizeMultiplier);\n",
              "    if (quack.y > floorY) {\n",
              "        quack.y = floorY;\n",
              "        quack.dy = 0;\n",
              "        quack.grounded = true;\n",
              "    }\n",
              "\n",
              "    companions.forEach(comp => {\n",
              "        comp.x = quack.x + comp.offset;\n",
              "        comp.y = quack.y + 15;\n",
              "    });\n",
              "\n",
              "    if (powerUpTimer > 0) {\n",
              "        powerUpTimer--;\n",
              "        if (powerUpTimer === 0) {\n",
              "            quack.sizeMultiplier = 1;\n",
              "            quack.hasThreeWings = false;\n",
              "            quack.hasGuard = false;\n",
              "            quack.speedBoost = 1;\n",
              "            quack.isSuper = false;\n",
              "            activePowerUpText = \"None\";\n",
              "        }\n",
              "    }\n",
              "\n",
              "    let currentSpeed = gameSpeed * quack.speedBoost;\n",
              "\n",
              "    for (let i = acorns.length - 1; i >= 0; i--) {\n",
              "        acorns[i].x -= currentSpeed;\n",
              "        if (\n",
              "            quack.x < acorns[i].x + acorns[i].width &&\n",
              "            quack.x + (48 * quack.sizeMultiplier) > acorns[i].x &&\n",
              "            quack.y < acorns[i].y + acorns[i].height &&\n",
              "            quack.y + (48 * quack.sizeMultiplier) > acorns[i].y\n",
              "        ) {\n",
              "            score += 10;\n",
              "            playAcornSound();\n",
              "            acorns.splice(i, 1);\n",
              "        } else if (acorns[i] && acorns[i].x < -30) {\n",
              "            acorns.splice(i, 1);\n",
              "        }\n",
              "    }\n",
              "\n",
              "    for (let i = powerups.length - 1; i >= 0; i--) {\n",
              "        powerups[i].x -= currentSpeed;\n",
              "        if (\n",
              "            quack.x < powerups[i].x + powerups[i].width &&\n",
              "            quack.x + (48 * quack.sizeMultiplier) > powerups[i].x &&\n",
              "            quack.y < powerups[i].y + powerups[i].height &&\n",
              "            quack.y + (48 * quack.sizeMultiplier) > powerups[i].y\n",
              "        ) {\n",
              "            activatePowerUp(powerups[i].type);\n",
              "            powerups.splice(i, 1);\n",
              "        } else if (powerups[i] && powerups[i].x < -30) {\n",
              "            powerups.splice(i, 1);\n",
              "        }\n",
              "    }\n",
              "\n",
              "    for (let i = obstacles.length - 1; i >= 0; i--) {\n",
              "        obstacles[i].x -= currentSpeed;\n",
              "\n",
              "        if (quack.hasGuard && obstacles[i].x < 280) {\n",
              "            obstacles[i].x -= 14;\n",
              "        }\n",
              "\n",
              "        if (\n",
              "            quack.x < obstacles[i].x + obstacles[i].width &&\n",
              "            quack.x + (48 * quack.sizeMultiplier) > obstacles[i].x &&\n",
              "            quack.y < obstacles[i].y + obstacles[i].height &&\n",
              "            quack.y + (48 * quack.sizeMultiplier) > obstacles[i].y\n",
              "        ) {\n",
              "            if (quack.isSuper || quack.hasGuard) {\n",
              "                obstacles.splice(i, 1);\n",
              "            } else {\n",
              "                isGameOver = true;\n",
              "                playGameOverSound();\n",
              "                if (score > highScore) {\n",
              "                    highScore = score;\n",
              "                    localStorage.setItem('featherRushHighScore', highScore);\n",
              "                    document.getElementById('highScoreCount').innerText = highScore;\n",
              "                }\n",
              "            }\n",
              "        } else if (obstacles[i] && obstacles[i].x < -40) {\n",
              "            obstacles.splice(i, 1);\n",
              "        }\n",
              "    }\n",
              "\n",
              "    document.getElementById('acornCount').innerText = score;\n",
              "    document.getElementById('activePowerUp').innerText = activePowerUpText;\n",
              "}\n",
              "\n",
              "function activatePowerUp(type) {\n",
              "    activePowerUpText = type;\n",
              "    powerUpTimer = 350;\n",
              "    if (type === 'Super Seed') {\n",
              "        quack.sizeMultiplier = 1.4;\n",
              "        quack.isSuper = true;\n",
              "    } else if (type === 'ThreeWings') {\n",
              "        quack.hasThreeWings = true;\n",
