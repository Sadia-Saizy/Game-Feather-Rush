        "            background: #16213e;\n",
        "            padding: 8px 18px;\n",
        "            border-radius: 8px;\n",
        "            display: inline-block;\n",
        "            border: 2px solid #0f3460;\n",
        "        }\n",
        "        .controls {\n",
        "            margin-top: 6px;\n",
        "            font-size: 13px;\n",
        "            color: #a0aec0;\n",
        "        }\n",
        "    </style>\n",
        "</head>\n",
        "<body>\n",
        "\n",
        "    <h2>Feather Rush: Peep, Chirp & Quack! 🦆🔊</h2>\n",
        "    <div id=\"game-container\">\n",
        "        <canvas id=\"gameCanvas\" width=\"800\" height=\"400\"></canvas>\n",
        "        <div id=\"startScreen\">\n",
        "            <h1 style=\"color: #FFD700; margin-bottom: 10px; font-size: 36px;\">FEATHER RUSH</h1>\n",
        "            <p style=\"font-size: 15px; max-width: 500px; margin-bottom: 25px; line-height: 1.4; color: #e2e8f0;\">\n",
        "                Help <strong>Quack</strong>, <strong>Peep</strong>, and <strong>Wisdom Bird</strong> race to <strong>Chirp</strong>! Collect Acorns for your Duck Wisdom stash!\n",
        "            </p>\n",
        "            <button id=\"startBtn\" onclick=\"startGame()\">START GAME ▶</button>\n",
        "        </div>\n",
        "    </div>\n",
        "\n",
        "    <br>\n",
        "    <button id=\"jumpBtn\" onclick=\"triggerJump()\">HIGH JUMP 🦘 / FLY</button>\n",
        "    <br>\n",
        "    <div class=\"ui-panel\">\n",
        "        <strong>Stash:</strong> <span id=\"acornCount\">0</span> |\n",
        "        <strong>High Score:</strong> <span id=\"highScoreCount\">0</span> |\n",
        "        <strong>Power-Up:</strong> <span id=\"activePowerUp\">None</span>\n",
        "    </div>\n",
        "    <div class=\"controls\">\n",
        "        Controls: Click the <strong>HIGH JUMP</strong> button, or press <strong>SPACEBAR</strong> / <strong>UP ARROW</strong> | Press <strong>R</strong> to Restart\n",
        "    </div>\n",
        "\n",
        "<script>\n",
        "const canvas = document.getElementById('gameCanvas');\n",
        "const ctx = canvas.getContext('2d');\n",
        "const startScreen = document.getElementById('startScreen');\n",
        "\n",
        "let score = 0;\n",
        "let highScore = localStorage.getItem('featherRushHighScore') || 0;\n",
        "document.getElementById('highScoreCount').innerText = highScore;\n",
        "\n",
        "let gameSpeed = 8;\n",
        "let isGameOver = false;\n",
        "let gameStarted = false;\n",
        "let activePowerUpText = \"None\";\n",
        "let powerUpTimer = 0;\n",
        "\n",
        "// Web Audio API Sound Synthesizer\n",
        "let audioCtx = null;\n",
        "function initAudio() {\n",
        "    if (!audioCtx) {\n",
        "        audioCtx = new (window.AudioContext || window.webkitAudioContext)();\n",
        "    }\n",
        "}\n",
        "\n",
        "function playJumpSound() {\n",
        "    initAudio();\n",
        "    if (!audioCtx) return;\n",
        "    let osc = audioCtx.createOscillator();\n",
        "    let gain = audioCtx.createGain();\n",
        "    osc.type = 'sine';\n",
        "    osc.frequency.setValueAtTime(150, audioCtx.currentTime);\n",
        "    osc.frequency.exponentialRampToValueAtTime(400, audioCtx.currentTime + 0.15);\n",
        "    gain.gain.setValueAtTime(0.15, audioCtx.currentTime);\n",
        "    gain.gain.linearRampToValueAtTime(0.01, audioCtx.currentTime + 0.15);\n",
        "    osc.connect(gain);\n",
        "    gain.connect(audioCtx.destination);\n",
        "    osc.start();\n",
        "    osc.stop(audioCtx.currentTime + 0.15);\n",
        "}\n",
        "\n",
        "function playAcornSound() {\n",
        "    initAudio();\n",
        "    if (!audioCtx) return;\n",
        "    let osc = audioCtx.createOscillator();\n",
        "    let gain = audioCtx.createGain();\n",
        "    osc.type = 'triangle';\n",
        "    osc.frequency.setValueAtTime(587.33, audioCtx.currentTime);\n",
        "    osc.frequency.setValueAtTime(880, audioCtx.currentTime + 0.08);\n",
        "    gain.gain.setValueAtTime(0.2, audioCtx.currentTime);\n",
        "    gain.gain.linearRampToValueAtTime(0.01, audioCtx.currentTime + 0.2);\n",
        "    osc.connect(gain);\n",
        "    gain.connect(audioCtx.destination);\n",
        "    osc.start();\n",
        "    osc.stop(audioCtx.currentTime + 0.2);\n",
        "}\n",
        "\n",
        "function playGameOverSound() {\n",
        "    initAudio();\n",
        "    if (!audioCtx) return;\n",
        "    let osc = audioCtx.createOscillator();\n",
        "    let gain = audioCtx.createGain();\n",
        "    osc.type = 'sawtooth';\n",
        "    osc.frequency.setValueAtTime(300, audioCtx.currentTime);\n",
        "    osc.frequency.linearRampToValueAtTime(80, audioCtx.currentTime + 0.4);\n",
        "    gain.gain.setValueAtTime(0.2, audioCtx.currentTime);\n",
        "    gain.gain.linearRampToValueAtTime(0.01, audioCtx.currentTime + 0.4);\n",
        "    osc.connect(gain);\n",
        "    gain.connect(audioCtx.destination);\n",
        "    osc.start();\n",
        "    osc.stop(audioCtx.currentTime + 0.4);\n",
        "}\n",
        "\n",
        "let quack = {\n",
        "    x: 80,\n",
        "    y: 260,\n",
        "    width: 48,\n",
        "    height: 48,\n",
        "    dy: 0,\n",
        "    jumpPower: -16,\n",
        "    gravity: 0.5,\n",
        "    grounded: true,\n",
        "    sizeMultiplier: 1,\n",
        "    hasThreeWings: false,\n",
        "    hasGuard: false,\n",
        "    isSuper: false,\n",
        "    speedBoost: 1\n",
        "};\n",
        "\n",
        "let companions = [\n",
        "    { x: 40, y: 275, name: \"Peep\", offset: -50 },\n",
        "    { x: 5, y: 275, name: \"Wisdom Bird\", offset: -100 }\n",
        "];\n",
        "\n",
        "let obstacles = [];\n",
        "let acorns = [];\n",
        "let powerups = [];\n",
        "\n",
        "function triggerJump() {\n",
        "    if (!gameStarted) {\n",
        "        startGame();\n",
        "        return;\n",
        "    }\n",
        "    if (isGameOver) {\n",
        "        resetGame();\n",
        "        return;\n",
        "    }\n",
        "    if (quack.grounded) {\n",
        "        quack.dy = quack.hasThreeWings ? quack.jumpPower * 1.35 : quack.jumpPower;\n",
        "        quack.grounded = false;\n",
        "        playJumpSound();\n",
        "    }\n",
        "}\n",
        "\n",
        "window.addEventListener('keydown', e => {\n",
        "    if ((e.code === 'Space' || e.code === 'ArrowUp')) {\n",
        "        e.preventDefault();\n",
        "        triggerJump();\n",
        "    }\n",
        "    if (e.code === 'KeyR' && isGameOver) {\n",
        "        resetGame();\n",
        "    }\n",
        "});\n",
        "\n",
        "let frameCount = 0;\n",
        "\n",
        "function spawnObstacle() {\n",
        "    obstacles.push({ x: canvas.width, y: 290, width: 35, height: 35 });\n",
        "}\n",
        "\n",
        "function spawnAcorn() {\n",
        "    acorns.push({ x: canvas.width, y: Math.random() * 140 + 130, width: 26, height: 26 });\n",
        "}\n",
        "\n",
        "function spawnPowerup() {\n",
        "    const types = ['Super Seed', 'ThreeWings', 'Money Tape', 'Santa Bird', 'Guard Bird', 'Rich Box'];\n",
        "    const chosenType = types[Math.floor(Math.random() * types.length)];\n",
        "    powerups.push({ x: canvas.width, y: Math.random() * 140 + 100, width: 30, height: 30, type: chosenType });\n",
        "}\n",
        "\n",
        "function startGame() {\n",
        "    startScreen.style.display = 'none';\n",
        "    gameStarted = true;\n",
        "    resetGame();\n",
        "    loop();\n",
        "}\n",
        "\n",
        "function resetGame() {\n",
        "    score = 0;\n",
        "    gameSpeed = 8;\n",
        "    isGameOver = false;\n",
        "    obstacles = [];\n",
        "    acorns = [];\n",
        "    powerups = [];\n",
        "    quack.y = 260;\n",
        "    quack.sizeMultiplier = 1;\n",
        "    quack.hasThreeWings = false;\n",
        "    quack.hasGuard = false;\n",
        "    quack.speedBoost = 1;\n",
        "    activePowerUpText = \"None\";\n",
        "}\n",
        "\n",
        "function update() {\n",
        "    if (!gameStarted || isGameOver) return;\n",
        "\n",
        "    frameCount++;\n",
        "\n",
        "    if (frameCount % 85 === 0) spawnObstacle();\n",
        "    if (frameCount % 55 === 0) spawnAcorn();\n",
        "    if (frameCount % 320 === 0) spawnPowerup();\n",
        "\n",
        "    quack.dy += quack.gravity;\n",
        "    quack.y += quack.dy;\n",
        "\n",
        "    let floorY = 325 - (48 * quack.sizeMultiplier);\n",
        "    if (quack.y > floorY) {\n",
        "        quack.y = floorY;\n",
        "        quack.dy = 0;\n",
        "        quack.grounded = true;\n",
        "    }\n",
        "\n",
        "    companions.forEach(comp => {\n",
        "        comp.x = quack.x + comp.offset;\n",
        "        comp.y = quack.y + 15;\n",
        "    });\n",
        "\n",
        "    if (powerUpTimer > 0) {\n",
        "        powerUpTimer--;\n",
        "        if (powerUpTimer === 0) {\n",
        "            quack.sizeMultiplier = 1;\n",
        "            quack.hasThreeWings = false;\n",
        "            quack.hasGuard = false;\n",
        "            quack.speedBoost = 1;\n",
        "            quack.isSuper = false;\n",
        "            activePowerUpText = \"None\";\n",
        "        }\n",
        "    }\n",
        "\n",
        "    let currentSpeed = gameSpeed * quack.speedBoost;\n",
        "\n",
        "    for (let i = acorns.length - 1; i >= 0; i--) {\n",
        "        acorns[i].x -= currentSpeed;\n",
        "        if (\n",
        "            quack.x < acorns[i].x + acorns[i].width &&\n",
        "            quack.x + (48 * quack.sizeMultiplier) > acorns[i].x &&\n",
        "            quack.y < acorns[i].y + acorns[i].height &&\n",
        "            quack.y + (48 * quack.sizeMultiplier) > acorns[i].y\n",
        "        ) {\n",
        "            score += 10;\n",
        "            playAcornSound();\n",
        "            acorns.splice(i, 1);\n",
        "        } else if (acorns[i] && acorns[i].x < -30) {\n",
        "            acorns.splice(i, 1);\n",
        "        }\n",
        "    }\n",
        "\n",
        "    for (let i = powerups.length - 1; i >= 0; i--) {\n",
        "        powerups[i].x -= currentSpeed;\n",
        "        if (\n",
        "            quack.x < powerups[i].x + powerups[i].width &&\n",
        "            quack.x + (48 * quack.sizeMultiplier) > powerups[i].x &&\n",
        "            quack.y < powerups[i].y + powerups[i].height &&\n",
        "            quack.y + (48 * quack.sizeMultiplier) > powerups[i].y\n",
        "        ) {\n",
        "            activatePowerUp(powerups[i].type);\n",
        "            powerups.splice(i, 1);\n",
        "        } else if (powerups[i] && powerups[i].x < -30) {\n",
        "            powerups.splice(i, 1);\n",
        "        }\n",
        "    }\n",
        "\n",
        "    for (let i = obstacles.length - 1; i >= 0; i--) {\n",
        "        obstacles[i].x -= currentSpeed;\n",
        "\n",
        "        if (quack.hasGuard && obstacles[i].x < 280) {\n",
        "            obstacles[i].x -= 14;\n",
        "        }\n",
        "\n",
        "        if (\n",
        "            quack.x < obstacles[i].x + obstacles[i].width &&\n",
        "            quack.x + (48 * quack.sizeMultiplier) > obstacles[i].x &&\n",
        "            quack.y < obstacles[i].y + obstacles[i].height &&\n",
        "            quack.y + (48 * quack.sizeMultiplier) > obstacles[i].y\n",
        "        ) {\n",
        "            if (quack.isSuper || quack.hasGuard) {\n",
        "                obstacles.splice(i, 1);\n",
        "            } else {\n",
        "                isGameOver = true;\n",
        "                playGameOverSound();\n",
        "                if (score > highScore) {\n",
        "                    highScore = score;\n",
        "                    localStorage.setItem('featherRushHighScore', highScore);\n",
        "                    document.getElementById('highScoreCount').innerText = highScore;\n",
        "                }\n",
        "            }\n",
        "        } else if (obstacles[i] && obstacles[i].x < -40) {\n",
        "            obstacles.splice(i, 1);\n",
        "        }\n",
        "    }\n",
        "\n",
        "    document.getElementById('acornCount').innerText = score;\n",
        "    document.getElementById('activePowerUp').innerText = activePowerUpText;\n",
        "}\n",
        "\n",
        "function activatePowerUp(type) {\n",
        "    activePowerUpText = type;\n",
        "    powerUpTimer = 350;\n",
        "    if (type === 'Super Seed') {\n",
        "        quack.sizeMultiplier = 1.4;\n",
        "        quack.isSuper = true;\n",
        "    } else if (type === 'ThreeWings') {\n",
        "        quack.hasThreeWings = true;\n",
        "    } else if (type === 'Money Tape') {\n",
        "        if (obstacles.length > 0) obstacles.shift();\n",
        "    } else if (type === 'Santa Bird') {\n",
        "        obstacles = [];\n",
        "    } else if (type === 'Guard Bird') {\n",
        "        quack.hasGuard = true;\n",
        "    } else if (type === 'Rich Box') {\n",
        "        quack.speedBoost = 2.0;\n",
        "    }\n",
        "}\n",
        "\n",
        "function draw() {\n",
        "    ctx.clearRect(0, 0, canvas.width, canvas.height);\n",
        "\n",
        "    // Ground\n",
        "    ctx.fillStyle = '#4CAF50';\n",
        "    ctx.fillRect(0, 325, canvas.width, 75);\n",
        "    ctx.fillStyle = '#388E3C';\n",
        "    ctx.fillRect(0, 325, canvas.width, 8);\n",
        "\n",
        "    // Goal: Chirp\n",
        "    ctx.fillStyle = '#FF3D00';\n",
        "    ctx.beginPath();\n",
        "    ctx.arc(740, 285, 20, 0, Math.PI * 2);\n",
        "    ctx.fill();\n",
        "    ctx.lineWidth = 2;\n",
        "    ctx.strokeStyle = '#000';\n",
        "    ctx.stroke();\n",
        "    ctx.fillStyle = '#FF9100';\n",
        "    ctx.beginPath();\n",
        "    ctx.moveTo(722, 283);\n",
        "    ctx.lineTo(700, 290);\n",
        "    ctx.lineTo(722, 297);\n",
        "    ctx.fill();\n",
        "    ctx.stroke();\n",
        "    ctx.fillStyle = '#FFF';\n",
        "    ctx.beginPath();\n",
        "    ctx.arc(745, 278, 5, 0, Math.PI * 2);\n",
        "    ctx.fill();\n",
        "    ctx.fillStyle = '#000';\n",
        "    ctx.beginPath();\n",
        "    ctx.arc(746, 278, 2, 0, Math.PI * 2);\n",
        "    ctx.fill();\n",
        "    ctx.fillStyle = '#000';\n",
        "    ctx.font = 'bold 11px sans-serif';\n",
        "    ctx.fillText(\"Chirp 🐦\", 715, 245);\n",
        "\n",
        "    // Acorns\n",
        "    acorns.forEach(a => {\n",
        "        let ax = a.x + 13;\n",
        "        let ay = a.y + 13;\n",
        "        ctx.fillStyle = '#A0522D';\n",
        "        ctx.beginPath();\n",
        "        ctx.ellipse(ax, ay + 4, 8, 10, 0, 0, Math.PI * 2);\n",
        "        ctx.fill();\n",
        "        ctx.lineWidth = 1.5;\n",
        "        ctx.strokeStyle = '#000';\n",
        "        ctx.stroke();\n",
        "\n",
        "        ctx.fillStyle = '#5C4033';\n",
        "        ctx.beginPath();\n",
        "        ctx.arc(ax, ay - 3, 8, Math.PI, Math.PI * 2);\n",
        "        ctx.fill();\n",
        "        ctx.stroke();\n",
        "\n",
        "        ctx.strokeStyle = '#5C4033';\n",
        "        ctx.lineWidth = 2;\n",
        "        ctx.beginPath();\n",
        "        ctx.moveTo(ax, ay - 11);\n",
        "        ctx.lineTo(ax, ay - 14);\n",
        "        ctx.stroke();\n",
        "    });\n",
        "\n",
        "    // Power-ups\n",
        "    powerups.forEach(p => {\n",
        "        ctx.fillStyle = '#FFD700';\n",
        "        ctx.fillRect(p.x, p.y, p.width, p.height);\n",
        "        ctx.lineWidth = 1.5;\n",
        "        ctx.strokeStyle = '#000';\n",
        "        ctx.stroke();\n",
        "        ctx.fillStyle = '#000';\n",
        "        ctx.font = 'bold 12px sans-serif';\n",
        "        ctx.fillText(\"★\", p.x + 9, p.y + 21);\n",
        "    });\n",
        "\n",
        "    // Obstacles\n",
        "    obstacles.forEach(obs => {\n",
        "        ctx.fillStyle = '#D32F2F';\n",
        "        ctx.beginPath();\n",
        "        ctx.arc(obs.x + 17, obs.y + 17, 18, 0, Math.PI * 2);\n",
        "        ctx.fill();\n",
        "        ctx.lineWidth = 2;\n",
        "        ctx.strokeStyle = '#000';\n",
        "        ctx.stroke();\n",
        "        ctx.fillStyle = '#fff';\n",
        "        ctx.font = '14px sans-serif';\n",
        "        ctx.fillText(\"😡\", obs.x + 7, obs.y + 22);\n",
        "    });\n",
        "\n",
        "    // Peep\n",
        "    let peep = companions[0];\n",
        "    ctx.fillStyle = '#FFEB3B';\n",
        "    ctx.beginPath();\n",
        "    ctx.arc(peep.x + 18, peep.y + 18, 18, 0, Math.PI * 2);\n",
        "    ctx.fill();\n",
        "    ctx.lineWidth = 2;\n",
        "    ctx.strokeStyle = '#000';\n",
        "    ctx.stroke();\n",
        "    ctx.fillStyle = '#FF9100';\n",
        "    ctx.beginPath();\n",
        "    ctx.moveTo(peep.x + 32, peep.y + 16);\n",
        "    ctx.lineTo(peep.x + 42, peep.y + 20);\n",
        "    ctx.lineTo(peep.x + 32, peep.y + 24);\n",
        "    ctx.fill();\n",
        "    ctx.stroke();\n",
        "    ctx.fillStyle = '#E53935';\n",
        "    ctx.beginPath();\n",
        "    ctx.arc(peep.x + 18, peep.y, 5, 0, Math.PI * 2);\n",
        "    ctx.fill();\n",
        "    ctx.fillStyle = '#FFF';\n",
        "    ctx.beginPath();\n",
        "    ctx.arc(peep.x + 24, peep.y + 14, 5, 0, Math.PI * 2);\n",
        "    ctx.fill();\n",
        "    ctx.fillStyle = '#000';\n",
        "    ctx.beginPath();\n",
        "    ctx.arc(peep.x + 25, peep.y + 14, 2, 0, Math.PI * 2);\n",
