              "\n",
              "let companions = [\n",
              "    { x: 40, y: 275, name: \"Peep\", offset: -50 },\n",
              "    { x: 5, y: 275, name: \"Wisdom Bird\", offset: -100 }\n",
              "];\n",
              "\n",
              "let obstacles = [];\n",
              "let acorns = [];\n",
              "let powerups = [];\n",
              "\n",
              "function triggerJump() {\n",
              "    if (!gameStarted) {\n",
              "        startGame();\n",
              "        return;\n",
              "    }\n",
              "    if (isGameOver) {\n",
              "        resetGame();\n",
              "        return;\n",
              "    }\n",
              "    if (quack.grounded) {\n",
              "        quack.dy = quack.hasThreeWings ? quack.jumpPower * 1.35 : quack.jumpPower;\n",
              "        quack.grounded = false;\n",
