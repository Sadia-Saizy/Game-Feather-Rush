        "            left: 0;\n",
        "            width: 100%;\n",
        "            height: 100%;\n",
        "            background: rgba(22, 33, 62, 0.95);\n",
        "            display: flex;\n",
        "            flex-direction: column;\n",
        "            justify-content: center;\n",
