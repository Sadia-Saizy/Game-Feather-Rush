              "    ctx.lineWidth = 2;\n",
              "    ctx.strokeStyle = '#000';\n",
              "    ctx.stroke();\n",
              "    ctx.fillStyle = '#FF9100';\n",
              "    ctx.beginPath();\n",
              "    ctx.moveTo(722, 283);\n",
              "    ctx.lineTo(700, 290);\n",
              "    ctx.lineTo(722, 297);\n",
              "    ctx.fill();\n",
              "    ctx.stroke();\n",
              "    ctx.fillStyle = '#FFF';\n",
              "    ctx.beginPath();\n",
              "    ctx.arc(745, 278, 5, 0, Math.PI * 2);\n",
              "    ctx.fill();\n",
              "    ctx.fillStyle = '#000';\n",
              "    ctx.beginPath();\n",
              "    ctx.arc(746, 278, 2, 0, Math.PI * 2);\n",
              "    ctx.fill();\n",
              "    ctx.fillStyle = '#000';\n",
              "    ctx.font = 'bold 11px sans-serif';\n",
              "    ctx.fillText(\"Chirp 🐦\", 715, 245);\n",
              "\n",
              "    // Acorns\n",
              "    acorns.forEach(a => {\n",
              "        let ax = a.x + 13;\n",
              "        let ay = a.y + 13;\n",
              "        ctx.fillStyle = '#A0522D';\n",
              "        ctx.beginPath();\n",
              "        ctx.ellipse(ax, ay + 4, 8, 10, 0, 0, Math.PI * 2);\n",
              "        ctx.fill();\n",
              "        ctx.lineWidth = 1.5;\n",
              "        ctx.strokeStyle = '#000';\n",
              "        ctx.stroke();\n",
              "\n",
              "        ctx.fillStyle = '#5C4033';\n",
              "        ctx.beginPath();\n",
              "        ctx.arc(ax, ay - 3, 8, Math.PI, Math.PI * 2);\n",
              "        ctx.fill();\n",
              "        ctx.stroke();\n",
              "\n",
              "        ctx.strokeStyle = '#5C4033';\n",
              "        ctx.lineWidth = 2;\n",
              "        ctx.beginPath();\n",
              "        ctx.moveTo(ax, ay - 11);\n",
              "        ctx.lineTo(ax, ay - 14);\n",
              "        ctx.stroke();\n",
              "    });\n",
              "\n",
              "    // Power-ups\n",
              "    powerups.forEach(p => {\n",
              "        ctx.fillStyle = '#FFD700';\n",
              "        ctx.fillRect(p.x, p.y, p.width, p.height);\n",
              "        ctx.lineWidth = 1.5;\n",
              "        ctx.strokeStyle = '#000';\n",
              "        ctx.stroke();\n",
              "        ctx.fillStyle = '#000';\n",
              "        ctx.font = 'bold 12px sans-serif';\n",
              "        ctx.fillText(\"★\", p.x + 9, p.y + 21);\n",
              "    });\n",
              "\n",
              "    // Obstacles\n",
              "    obstacles.forEach(obs => {\n",
              "        ctx.fillStyle = '#D32F2F';\n",
              "        ctx.beginPath();\n",
              "        ctx.arc(obs.x + 17, obs.y + 17, 18, 0, Math.PI * 2);\n",
              "        ctx.fill();\n",
              "        ctx.lineWidth = 2;\n",
              "        ctx.strokeStyle = '#000';\n",
              "        ctx.stroke();\n",
              "        ctx.fillStyle = '#fff';\n",
              "        ctx.font = '14px sans-serif';\n",
              "        ctx.fillText(\"😡\", obs.x + 7, obs.y + 22);\n",
              "    });\n",
              "\n",
              "    // Peep\n",
              "    let peep = companions[0];\n",
              "    ctx.fillStyle = '#FFEB3B';\n",
              "    ctx.beginPath();\n",
              "    ctx.arc(peep.x + 18, peep.y + 18, 18, 0, Math.PI * 2);\n",
              "    ctx.fill();\n",
              "    ctx.lineWidth = 2;\n",
              "    ctx.strokeStyle = '#000';\n",
              "    ctx.stroke();\n",
              "    ctx.fillStyle = '#FF9100';\n",
              "    ctx.beginPath();\n",
              "    ctx.moveTo(peep.x + 32, peep.y + 16);\n",
              "    ctx.lineTo(peep.x + 42, peep.y + 20);\n",
              "    ctx.lineTo(peep.x + 32, peep.y + 24);\n",
              "    ctx.fill();\n",
              "    ctx.stroke();\n",
              "    ctx.fillStyle = '#E53935';\n",
              "    ctx.beginPath();\n",
              "    ctx.arc(peep.x + 18, peep.y, 5, 0, Math.PI * 2);\n",
              "    ctx.fill();\n",
              "    ctx.fillStyle = '#FFF';\n",
              "    ctx.beginPath();\n",
              "    ctx.arc(peep.x + 24, peep.y + 14, 5, 0, Math.PI * 2);\n",
              "    ctx.fill();\n",
              "    ctx.fillStyle = '#000';\n",
              "    ctx.beginPath();\n",
              "    ctx.arc(peep.x + 25, peep.y + 14, 2, 0, Math.PI * 2);\n",
              "    ctx.fill();\n",
              "\n",
              "    // Wisdom Bird\n",
              "    let wisdom = companions[1];\n",
              "    ctx.fillStyle = '#7E57C2';\n",
              "    ctx.beginPath();\n",
              "    ctx.arc(wisdom.x + 18, wisdom.y + 18, 18, 0, Math.PI * 2);\n",
              "    ctx.fill();\n",
              "    ctx.lineWidth = 2;\n",
              "    ctx.strokeStyle = '#000';\n",
              "    ctx.stroke();\n",
              "    ctx.fillStyle = '#FF9100';\n",
              "    ctx.beginPath();\n",
              "    ctx.moveTo(wisdom.x + 32, wisdom.y + 16);\n",
              "    ctx.lineTo(wisdom.x + 42, wisdom.y + 20);\n",
              "    ctx.lineTo(wisdom.x + 32, wisdom.y + 24);\n",
              "    ctx.fill();\n",
              "    ctx.stroke();\n",
              "    ctx.strokeStyle = '#000';\n",
              "    ctx.lineWidth = 2.5;\n",
              "    ctx.strokeRect(wisdom.x + 14, wisdom.y + 10, 10, 8);\n",
              "    ctx.fillStyle = '#000';\n",
              "    ctx.beginPath();\n",
              "    ctx.arc(wisdom.x + 19, wisdom.y + 14, 2, 0, Math.PI * 2);\n",
              "    ctx.fill();\n",
              "\n",
              "    // Quack\n",
              "    let qSize = 22 * quack.sizeMultiplier;\n",
              "    ctx.fillStyle = quack.hasGuard ? '#00BCD4' : '#7E57C2';\n",
              "    ctx.beginPath();\n",
              "    ctx.arc(quack.x + qSize, quack.y + qSize, qSize, 0, Math.PI * 2);\n",
              "    ctx.fill();\n",
              "    ctx.lineWidth = 2;\n",
              "    ctx.strokeStyle = '#000';\n",
              "    ctx.stroke();\n",
              "\n",
              "    ctx.fillStyle = '#FF9100';\n",
              "    ctx.beginPath();\n",
              "    ctx.moveTo(quack.x + (qSize * 2) - 4, quack.y + qSize - 2);\n",
              "    ctx.lineTo(quack.x + (qSize * 2) + 10, quack.y + qSize + 3);\n",
              "    ctx.lineTo(quack.x + (qSize * 2) - 4, quack.y + qSize + 8);\n",
              "    ctx.fill();\n",
              "    ctx.stroke();\n",
              "\n",
              "    ctx.fillStyle = '#FFF';\n",
              "    ctx.beginPath();\n",
              "    ctx.arc(quack.x + qSize + 6, quack.y + qSize - 4, 6, 0, Math.PI * 2);\n",
              "    ctx.fill();\n",
              "    ctx.fillStyle = '#000';\n",
              "    ctx.beginPath();\n",
              "    ctx.arc(quack.x + qSize + 8, quack.y + qSize - 4, 2.5, 0, Math.PI * 2);\n",
              "    ctx.fill();\n",
              "\n",
              "    ctx.fillStyle = '#FFF';\n",
              "    ctx.fillRect(quack.x + qSize - 12, quack.y - 6, 24, 10);\n",
              "    ctx.lineWidth = 2;\n",
              "    ctx.strokeStyle = '#000';\n",
              "    ctx.strokeRect(quack.x + qSize - 12, quack.y - 6, 24, 10);\n",
              "\n",
              "    ctx.fillStyle = '#000';\n",
              "    ctx.font = 'bold 12px sans-serif';\n",
              "    ctx.fillText(\"Quack 🦆\", quack.x - 2, quack.y - 12);\n",
              "\n",
              "    // Game Over\n",
              "    if (isGameOver) {\n",
              "        ctx.fillStyle = 'rgba(0, 0, 0, 0.8)';\n",
              "        ctx.fillRect(0, 0, canvas.width, canvas.height);\n",
              "        ctx.fillStyle = '#FFFFFF';\n",
              "        ctx.font = '28px sans-serif';\n",
              "        ctx.fillText(\"Game Over!\", 320, 170);\n",
              "        ctx.font = '16px sans-serif';\n",
              "        ctx.fillText(\"Press 'R' or Click Button to Try Again\", 240, 210);\n",
              "    }\n",
              "}\n",
              "\n",
              "function loop() {\n",
              "    update();\n",
              "    draw();\n",
              "    if (gameStarted) {\n",
              "        requestAnimationFrame(loop);\n",
              "    }\n",
              "}\n",
              "</script>\n",
