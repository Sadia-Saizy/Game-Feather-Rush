              "</head>\n",
              "<body>\n",
              "\n",
              "    <h2>Feather Rush: Peep, Chirp & Quack! 🦆🔊</h2>\n",
              "    <div id=\"game-container\">\n",
              "        <canvas id=\"gameCanvas\" width=\"800\" height=\"400\"></canvas>\n",
              "        <div id=\"startScreen\">\n",
              "            <h1 style=\"color: #FFD700; margin-bottom: 10px; font-size: 36px;\">FEATHER RUSH</h1>\n",
              "            <p style=\"font-size: 15px; max-width: 500px; margin-bottom: 25px; line-height: 1.4; color: #e2e8f0;\">\n",
              "                Help <strong>Quack</strong>, <strong>Peep</strong>, and <strong>Wisdom Bird</strong> race to <strong>Chirp</strong>! Collect Acorns for your Duck Wisdom stash!\n",
